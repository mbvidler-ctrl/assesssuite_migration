{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:landing",
  "outputDirectory": "apps/landing/dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/Landing",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/Settings",
      "destination": "https://app.assesssuite.com/MyProfile",
      "permanent": false
    },
    {
      "source": "/:path(login|register|forgot-password|reset-password|Paywall|PaymentRequired|CreateAccount|AccountSetup|signin|LegalNotices|AccountDeactivated|signup|AdminAnalytics|AdminApprovals|AssessmentAudit|AssessmentLibrary|Calendar|ClientConditions|ClientProfile|Clients|Dashboard|Finances|FundingForms|Home|MyProfile|NewAssessment|NewAssessmentCreator|Nutrition|Onboarding|PendingApproval|ProfileSetup|Reports|TestRunner|TreatmentProtocols)",
      "destination": "https://app.assesssuite.com/:path",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/legal/:slug",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://va.vercel-scripts.com; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests" }
      ]
    }
  ]
}
