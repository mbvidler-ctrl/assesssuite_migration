+  assert.match(sandboxConfig, /^\s*SANDBOX_MODE = "1"\s*$/m);
+  for (const gate of ['OUTBOUND_EMAIL_ENABLED', 'OUTBOUND_SMS_ENABLED', 'PAYMENTS_ENABLED']) {
