# AssessSuite Physio — independent target image built from the shared source
# commit. The profession and app identity are fixed in both stages so neither
# the browser bundle nor the server process can fall back to EP.
FROM node:24-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS build-base
ARG RELEASE_SHA
ARG SOURCE_BRANCH
ARG BUILD_TIMESTAMP
ARG SENTRY_DSN
WORKDIR /app
ENV RELEASE_SHA=${RELEASE_SHA} \
    SOURCE_BRANCH=${SOURCE_BRANCH} \
    BUILD_TIMESTAMP=${BUILD_TIMESTAMP} \
    PROFESSION=physio \
    DEFAULT_APP_ID=local-assesssuite-physio \
    VITE_BASE44_APP_ID=local-assesssuite-physio \
    VITE_PROFESSION=physio \
    VITE_SENTRY_DSN=${SENTRY_DSN} \
    VITE_SENTRY_RELEASE=physio-production@${RELEASE_SHA} \
    VITE_SENTRY_ENVIRONMENT=physio-production
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run catalogue:physio:check
RUN npm run build:physio
RUN ./node_modules/.bin/sentry-cli sourcemaps inject /app/dist

# This scratch target exposes the injected source maps and their exact sibling
# JavaScript bytes to the release workflow. BuildKit produces it in the same
# multi-target build as `runtime`; no second Vite build is permitted.
FROM scratch AS sourcemap-evidence
COPY --from=build-base /app/dist /dist

FROM build-base AS build-runtime
# Resolve and seal the transitive production dependency closure from the same
# source tree and browser build used by the sourcemap-evidence target. The
# builder rejects mock/self-test implementations, EP-only server modules,
# source maps, test suites and dormant browser source before the final image is
# assembled.
RUN NODE_ENV=production node scripts/build-physio-runtime-tree.mjs --output /app/.physio-runtime
RUN npm prune --omit=dev

FROM node:24-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS runtime
ARG RELEASE_SHA
ARG SOURCE_BRANCH
ARG BUILD_TIMESTAMP
WORKDIR /app
ENV NODE_ENV=production \
    PORT=8787 \
    PROFESSION=physio \
    DEFAULT_APP_ID=local-assesssuite-physio \
    RELEASE_SHA=${RELEASE_SHA} \
    SENTRY_RELEASE=physio-production@${RELEASE_SHA} \
    SENTRY_ENVIRONMENT=physio-production \
    SOURCE_BRANCH=${SOURCE_BRANCH} \
    BUILD_TIMESTAMP=${BUILD_TIMESTAMP}
COPY --from=build-runtime /app/node_modules ./node_modules
COPY --from=build-runtime /app/.physio-runtime/ ./
EXPOSE 8787
CMD ["sh", "-c", "node server/productionBootstrap.mjs && exec node server/index.mjs"]
